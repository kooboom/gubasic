' 슈팅 게임의 정석(docs/DESIGN.md D138): Timer 하나가 게임 루프이고,
' 물체마다 상태(Sprite와 배열)가 있으며, 적은 시간표대로 나옵니다.
' ← →로 움직이고 스페이스로 쏩니다. 키보드가 있는 데스크톱과 웹용입니다.

' 적이 나오는 시간표의 한 줄: 몇 ms에, 몇 번째 길에, 어떤 적이.
Structure Wave
    At As Integer           ' 시작한 뒤 흐른 ms
    Lane As Integer         ' 0부터 4까지, 왼쪽부터
    Kind As Integer         ' 0: 느린 적, 1: 빠른 적
End Structure

Const Lanes As Integer = 5
Const ShipSpeed As Double = 240     ' 초당 픽셀
Const ShotSpeed As Double = -420
Const FireGap As Integer = 220      ' 발사 사이의 ms

Dim shots(7) As Sprite
Dim enemies(19) As Sprite
Dim boomUntil(19) As Integer        ' 터지는 적이 사라질 때(ms); 0이면 터지는 중이 아님
Dim waves(23) As Wave
Dim nextWave As Integer
Dim startedAt As Integer
Dim lastTime As Integer
Dim lastShot As Integer
Dim score As Integer
Dim lives As Integer

Sub Form_Load()
    Dim i As Integer
    ' 탄과 적은 미리 만들어 두고, 쓸 때만 보입니다(Visible).
    For i = 0 To UBound(shots)
        shots(i) = New Sprite With {.Frames = "shot.png", .Width = 6, .Height = 14,
                                    .Shape = "Rectangle", .SpeedY = ShotSpeed, .Visible = False}
        Me.Controls.Add(shots(i))
    Next
    For i = 0 To UBound(enemies)
        enemies(i) = New Sprite With {.Frames = "enemy1.png, enemy2.png", .FrameTime = 150,
                                      .Width = 32, .Height = 32, .Shape = "Circle", .Visible = False}
        Me.Controls.Add(enemies(i))
    Next
    ' 시간표: 처음에는 느린 적이 하나씩, 나중에는 빠른 적이 둘씩.
    For i = 0 To 11
        waves(i) = New Wave With {.At = 1000 + i * 1500, .Lane = (i * 3) Mod Lanes, .Kind = 0}
    Next
    For i = 12 To 23
        waves(i) = New Wave With {.At = 19000 + (i - 12) * 900, .Lane = (i * 2 + 1) Mod Lanes, .Kind = 1}
    Next
    lblMessage.Caption = "시작을 누르세요"
End Sub

Sub btnStart_Click()
    Dim i As Integer
    For i = 0 To UBound(shots)
        shots(i).Visible = False
    Next
    For i = 0 To UBound(enemies)
        enemies(i).Visible = False
        boomUntil(i) = 0
    Next
    score = 0
    lives = 3
    nextWave = 0
    sprShip.X = (Me.Width - sprShip.Width) / 2
    sprShip.Visible = True
    ShowStatus()
    lblMessage.Caption = ""
    btnStart.Enabled = False
    ' 웹에서는 클릭 뒤에야 소리가 납니다: 시작 버튼이 그 클릭입니다.
    Sound.PlayMusic("music.wav")
    startedAt = Milliseconds()
    lastTime = startedAt
    lastShot = 0
    tmrGame.Start()
End Sub

' 게임 루프: 흐른 시간을 재고, 키를 읽고, 모두 움직이고, 부딪힘을 봅니다.
Sub tmrGame_Tick()
    Dim now As Integer = Milliseconds()
    Dim dt As Integer = now - lastTime
    lastTime = now
    Dim i As Integer
    Dim j As Integer

    ' 1. 우주선: 누른 키대로 속도를 정하고 움직입니다. 화면 밖으로는 못 갑니다.
    sprShip.SpeedX = 0
    If Keyboard.IsDown(Keys.Left) Then sprShip.SpeedX = -ShipSpeed
    If Keyboard.IsDown(Keys.Right) Then sprShip.SpeedX = ShipSpeed
    sprShip.Move(dt)
    If sprShip.X < 0 Then sprShip.X = 0
    If sprShip.X > Me.Width - sprShip.Width Then sprShip.X = Me.Width - sprShip.Width

    ' 2. 발사: 스페이스를 누르고 있으면 FireGap마다 쉬는 탄 하나를 씁니다.
    If Keyboard.IsDown(Keys.Space) And now - lastShot >= FireGap Then
        For i = 0 To UBound(shots)
            If Not shots(i).Visible Then
                shots(i).X = sprShip.X + (sprShip.Width - shots(i).Width) / 2
                shots(i).Y = sprShip.Y - shots(i).Height
                shots(i).Visible = True
                lastShot = now
                Sound.Play("shot.wav")
                Exit For
            End If
        Next
    End If

    ' 3. 시간표: 때가 된 적을 내보냅니다.
    Do While nextWave <= UBound(waves)
        If now - startedAt < waves(nextWave).At Then Exit Do
        Spawn(waves(nextWave))
        nextWave = nextWave + 1
    Loop

    ' 4. 탄과 적을 움직입니다. 화면을 벗어난 탄은 쉬고, 벗어난 적은 목숨을 하나 뺏습니다.
    For i = 0 To UBound(shots)
        If shots(i).Visible Then
            shots(i).Move(dt)
            If shots(i).Y + shots(i).Height < 0 Then shots(i).Visible = False
        End If
    Next
    For i = 0 To UBound(enemies)
        If enemies(i).Visible Then
            enemies(i).Move(dt)
            If boomUntil(i) > 0 Then
                If now >= boomUntil(i) Then
                    enemies(i).Visible = False
                    boomUntil(i) = 0
                End If
            ElseIf enemies(i).Y > Me.Height Then
                enemies(i).Visible = False
                LoseLife()
            End If
        End If
    Next

    ' 5. 부딪힘: 탄마다 적마다 Hits 한 번씩. 맞은 적은 터지는 그림으로 바뀝니다.
    For i = 0 To UBound(shots)
        If shots(i).Visible Then
            For j = 0 To UBound(enemies)
                If enemies(j).Visible And boomUntil(j) = 0 Then
                    If shots(i).Hits(enemies(j)) Then
                        shots(i).Visible = False
                        Explode(j, now)
                        score = score + 10
                        ShowStatus()
                        Exit For
                    End If
                End If
            Next
        End If
    Next
    For j = 0 To UBound(enemies)
        If enemies(j).Visible And boomUntil(j) = 0 Then
            If sprShip.Hits(enemies(j)) Then
                Explode(j, now)
                LoseLife()
            End If
        End If
    Next
End Sub

' 시간표의 한 줄대로 쉬는 적 하나를 길 위에 내보냅니다.
Sub Spawn(wave As Wave)
    Dim i As Integer
    For i = 0 To UBound(enemies)
        If Not enemies(i).Visible Then
            Dim laneWidth As Double = Me.Width / Lanes
            enemies(i).Frames = "enemy1.png, enemy2.png"
            enemies(i).FrameTime = 150
            enemies(i).X = wave.Lane * laneWidth + (laneWidth - enemies(i).Width) / 2
            enemies(i).Y = -enemies(i).Height
            enemies(i).SpeedY = 90 + wave.Kind * 70
            enemies(i).Visible = True
            boomUntil(i) = 0
            Exit For
        End If
    Next
End Sub

' 적이 터집니다: 그림이 폭발로 바뀌고, 멈춘 채 잠시 뒤 사라집니다.
Sub Explode(index As Integer, now As Integer)
    enemies(index).Frames = "boom1.png, boom2.png, boom3.png"
    enemies(index).FrameTime = 80
    enemies(index).SpeedY = 0
    boomUntil(index) = now + 240
    Sound.Play("hit.wav")
End Sub

Sub LoseLife()
    lives = lives - 1
    ShowStatus()
    If lives <= 0 Then GameOver()
End Sub

Sub GameOver()
    tmrGame.Stop()
    Sound.StopMusic()
    sprShip.Visible = False
    lblMessage.Caption = "게임 끝: " & score & "점"
    btnStart.Caption = "다시"
    btnStart.Enabled = True
End Sub

Sub ShowStatus()
    lblScore.Caption = "점수 " & score
    lblLives.Caption = "목숨 " & lives
End Sub
