' Integer and Double arithmetic, operator results, precedence.
Sub Main()
    Debug.Print(7 + 3 * 2)
    Debug.Print(7 / 2)
    Debug.Print(7 \ 2)
    Debug.Print(-7 \ 2)
    Debug.Print(7 Mod 3)
    Debug.Print(-7 Mod 3)
    Debug.Print(7.5 Mod 2)
    Debug.Print(2 ^ 10)
    Debug.Print(2 ^ 3 ^ 2)
    Debug.Print(-2 ^ 2)
    Debug.Print(1 + 2 * 3 ^ 2)
    Debug.Print(10 / 4 * 2)
    Debug.Print(0.1 + 0.2)
    Debug.Print(1 / 3)
    Debug.Print(10.0 ^ 20 * 10)
    Debug.Print(10.0 ^ 400)
End Sub
