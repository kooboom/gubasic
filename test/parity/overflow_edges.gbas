' Integer limits: which operations overflow (R001) and which do not.
Sub Main()
    Try
        Debug.Print(Integer.MinValue \ -1)
    Catch ex As Exception
        Debug.Print("MinValue \ -1: " & ex.Message)
    End Try
    Try
        Debug.Print(-Integer.MinValue)
    Catch ex As Exception
        Debug.Print("-MinValue: " & ex.Message)
    End Try
    Try
        Debug.Print(Abs(Integer.MinValue))
    Catch ex As Exception
        Debug.Print("Abs(MinValue): " & ex.Message)
    End Try
    Try
        Debug.Print("MinValue Mod -1 = " & (Integer.MinValue Mod -1))
    Catch ex As Exception
        Debug.Print("MinValue Mod -1: " & ex.Message)
    End Try
    Try
        Debug.Print(CInt(9.3E+18))
    Catch ex As Exception
        Debug.Print("CInt(9.3E+18): " & ex.Message)
    End Try
    Debug.Print("Done")
End Sub
